// Lifts a panel's colour toward white along its top edge: the faint studio-light sheen on glass cards.
uniform shader src;
uniform float height;
uniform float strength;

half4 main(float2 p) {
    half4 c = src.eval(p);
    if (c.a <= 0.0) return c;
    float g = mix(strength, 0.0, (p.y - 0.5) / max(height - 1.0, 1.0));
    half3 straight = min(c.rgb / c.a + half(g) * c.a, half3(1.0));
    return half4(straight * c.a, c.a);
}
