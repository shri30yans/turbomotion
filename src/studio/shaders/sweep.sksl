// A slow diagonal light band, added to what is underneath (see `add_clip.sksl`).
uniform float2 res;
uniform float2 dir;      // cos, sin of the sweep angle
uniform float centre;    // band centre along the sweep axis, px from the frame centre
uniform float sigma;
uniform float strength;

half4 main(float2 p) {
    float2 q = p - 0.5 - res * 0.5;
    float proj = q.x * dir.x - q.y * dir.y;
    float m = strength * exp(-0.5 * pow((proj - centre) / sigma, 2.0));
    return half4(half3(m), 0.0);
}
