// Paper stock: a flat colour with broad mottling and fine fibre, from two stored noise fields (0.5 + 0.1 * n).
uniform shader coarse;
uniform shader fine;
uniform float3 stock;

half4 main(float2 p) {
    float broad = (coarse.eval(p).r - 0.5) * 10.0 * 0.012;
    float fibre = (fine.eval(p).r - 0.5) * 10.0 * 0.03;
    return half4(half3(clamp(stock + broad + fibre, 0.0, 1.0)), 1.0);
}
