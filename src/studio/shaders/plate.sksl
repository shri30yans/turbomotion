// A photographic plate: the sharp frame and its blurred copy mixed by a soft-focus mask around the focus point
// (depth-of-field feel), then graded. Opaque. Follows the grade prelude.
uniform shader sharp;
uniform shader soft;
uniform float2 focus;    // focus centre as fractions of the frame
uniform float2 frame;    // frame width, height

half4 main(float2 p) {
    float2 q = (p - 0.5) / frame;       // pixel index / size
    float dx = (q.x - focus.x) * 1.2;
    float dy = q.y - focus.y;
    float keep = clamp(1.25 - sqrt(dx * dx + dy * dy) * 2.0, 0.0, 1.0);
    half3 c = mix(soft.eval(p).rgb, sharp.eval(p).rgb, half(keep));
    return half4(grade(c), 1.0);
}
