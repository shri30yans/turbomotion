// One axis of an area-averaging resize: each output pixel is the mean of the source interval it covers, edge pixels
// weighted by their overlap (OpenCV's INTER_AREA).
uniform shader src;
uniform float2 axis;        // (1, 0) resizes columns, (0, 1) rows
uniform float ratio;        // source pixels per output pixel along the axis

half4 main(float2 p) {
    float2 across = float2(1.0) - axis;
    float2 q = p - 0.5;
    float i = dot(axis, q);
    float lo = i * ratio;
    float hi = (i + 1.0) * ratio;
    half3 sum = half3(0.0);
    for (int j = 0; j < 64; j++) {
        float s = floor(lo) + float(j);
        if (s >= hi) break;
        float weight = min(s + 1.0, hi) - max(s, lo);
        sum += src.eval(axis * (s + 0.5) + across * p).rgb * half(weight);
    }
    return half4(sum / half(ratio), 1.0);
}
