// RGB split plus horizontal slice displacement on one frame (the reference `tr_glitch`).
uniform shader base;       // sampled at exact texels
uniform float frame_w;
uniform float split;       // whole pixels the red and blue channels part by
uniform float count;       // slices in use
uniform float4 slices[16]; // first row, one past the last row, shift, unused

half4 main(float2 p) {
    float2 q = floor(p);
    float shift = 0.0;
    for (int i = 0; i < 16; i++) {
        if (float(i) < count && q.y >= slices[i].x && q.y < slices[i].y) shift = slices[i].z;   // later slices win
    }
    float x = q.x - shift;
    half r = base.eval(float2(mod(x - split, frame_w) + 0.5, q.y + 0.5)).r;
    half g = base.eval(float2(mod(x, frame_w) + 0.5, q.y + 0.5)).g;
    half b = base.eval(float2(mod(x + split, frame_w) + 0.5, q.y + 0.5)).b;
    return half4(r, g, b, 1.0);
}
