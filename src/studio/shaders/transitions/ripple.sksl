// A shockwave ring that displaces both frames and dissolves A into B behind its front (the reference `tr_ripple`).
uniform shader a;
uniform shader b;
uniform float2 frame;
uniform float front;       // radius of the wave front in pixels
uniform float strength;    // peak displacement in pixels

half4 main(float2 p) {
    float2 q = p - 0.5 - frame * 0.5;
    float r = length(q) + 1e-3;
    float push = strength * exp(-pow((r - front) / 90.0, 2.0));
    float2 at = p + q / r * push;
    float m = clamp((front - r) / 160.0 + 0.5, 0.0, 1.0);
    return half4(mix(a.eval(at).rgb, b.eval(at).rgb, half(m)), 1.0);
}
