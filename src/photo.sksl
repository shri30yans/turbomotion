// Depth parallax, colour grade, vignette and dim in one pass.
uniform shader img;
uniform shader dep;
uniform float2 res;
uniform float4 rect;      // x, y, w, h in output pixels
uniform float2 imgSize;
uniform float2 depSize;
uniform float2 shift;
uniform float2 focus;
uniform float dolly;
uniform float hasDepth;
uniform float grade;      // 0 warm, 1 archival, 2 painting
uniform float vig;
uniform float dim;

float depthAt(float2 uv) {
    return hasDepth > 0.5 ? dep.eval(clamp(uv, float2(0.001), float2(0.999)) * depSize).r : 0.5;
}

float2 warp(float2 uv, float d) {
    float k = d - 0.5;
    float2 u = uv - shift * k;
    return focus + (u - focus) / (1.0 + dolly * k);
}

half4 main(float2 px) {
    float2 uv = (px - rect.xy) / rect.zw;
    float d = depthAt(uv);
    float2 s = warp(uv, d);
    d = depthAt(s);            // one refinement step reduces edge tearing
    s = warp(uv, d);
    float3 c = img.eval(clamp(s, float2(0.0005), float2(0.9995)) * imgSize).rgb;
    float l = dot(c, float3(0.299, 0.587, 0.114));
    if (grade < 0.5) {         // warm documentary grade
        c = mix(float3(l), c, 1.06);
        c = c * c * (3.0 - 2.0 * c) * 0.25 + c * 0.75;
        c *= float3(1.035, 1.0, 0.955);
        c = c * 0.97 + 0.018;
    } else if (grade < 1.5) {  // archival: sepia, lifted blacks
        float3 sep = float3(l * 1.07 + 0.04, l * 0.96 + 0.025, l * 0.80);
        c = mix(sep, sep * sep * (3.0 - 2.0 * sep), 0.5) * 0.92 + 0.045;
    } else {                   // painting / illustration: neutral, light protection
        c = c * 0.985 + 0.01;
    }
    float2 q = px / res - 0.5;
    c *= 1.0 - vig * smoothstep(0.35, 0.95, length(q * float2(1.0, 0.82)));
    c *= 1.0 - dim;
    return half4(half3(c), 1.0);
}
