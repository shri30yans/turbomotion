// Zoom blur about a point: the mean of copies scaled from 1x to (1 + amount)x.
uniform shader src;
uniform float2 centre;
uniform float amount;
uniform float taps;

half4 main(float2 p) {
    half4 sum = half4(0.0);
    for (int i = 0; i < 64; i++) {
        if (float(i) >= taps) break;
        float s = 1.0 + amount * float(i) / (taps - 1.0);
        sum += src.eval(centre + (p - centre) / s);
    }
    return sum / half(taps);
}
