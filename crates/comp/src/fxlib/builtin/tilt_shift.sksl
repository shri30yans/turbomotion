// @effect tilt_shift
// @summary Blurs everything outside a horizontal band so a scene reads as a miniature.
// @bounds expand=blur
// @space linear
// @param focus float 0.5 0 1 -- vertical centre of the sharp band (fraction of the height)
// @param band float 0.18 0.02 0.6 -- half-height of the sharp band
// @param blur float 14 0 60 -- maximum blur radius in px
half4 main(float2 xy) {
    float v = xy.y / resolution.y;
    float k = smoothstep(band, band + 0.3, abs(v - focus));
    float r = blur * k;
    if (r < 0.5) {
        float4 s = straight(xy);
        return premul(s.rgb, s.a);
    }
    float3 acc = float3(0.0);
    float a = 0.0;
    for (int i = 0; i < 16; i++) {
        float ang = float(i) * 2.399963;
        float rad = sqrt((float(i) + 0.5) / 16.0) * r;
        float4 s = straight(xy + float2(cos(ang), sin(ang)) * rad);
        acc += s.rgb * s.a;
        a += s.a;
    }
    float3 rgb = a > 0.0 ? acc / a : float3(0.0);
    return premul(rgb, a / 16.0);
}
