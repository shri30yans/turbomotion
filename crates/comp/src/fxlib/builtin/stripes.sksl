// @effect stripes
// @kind generator
// @summary Diagonal or straight bars; animate `offset` to make them travel.
// @bounds none
// @param width float 40 2 400 -- bar width in px
// @param angle float 45 -90 90 -- direction of the bars in degrees
// @param offset float 0 -1000 1000 -- shifts the pattern, px
// @param a color #ffffff -- first bar colour
// @param b color #101010 -- second bar colour
// @param softness float 1 0.5 40 -- edge blur in px
half4 main(float2 xy) {
    float2 p = rot2(xy - resolution * 0.5, radians(angle));
    float m = mod(p.x + offset, width * 2.0);
    float k = smoothstep(0.0, softness, m) * (1.0 - smoothstep(width, width + softness, m));
    float4 c = mix(b, a, k);
    return premul(c.rgb, c.a);
}
