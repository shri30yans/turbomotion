// @effect bolt
// @kind generator
// @summary A photoreal branched strike on a clear plate. Blend `add` or `screen` over the scene.
// @bounds none
// @param x float 0.5 0 1 -- origin, share of the width
// @param y float 0.0 0 1 -- origin, share of the height (0 is the top)
// @param seed float 2 0 40 -- which fork pattern
// @param thickness float 1.0 0.3 3 -- how wide the core is
// @param tint color #d7e8ff -- colour of the light
half4 main(float2 xy) {
    float2 p = xy / max(resolution, float2(1.0, 1.0));
    float aspect = resolution.x / max(resolution.y, 1.0);
    float2 q = float2((p.x - x) * aspect, p.y - y);
    float wander = (fbm(float2(q.y * 8.0, seed + time * 0.02)) - 0.5) * 0.2;
    float d0 = abs(q.x - wander);
    float core = exp(-d0 * d0 * 3200.0 / thickness);
    float wander2 = (fbm(float2(q.y * 15.0, seed + 5.0)) - 0.5) * 0.5;
    float fork_on = step(0.5, fbm(float2(q.y * 3.2, seed + 2.2)));
    float d1 = abs(q.x - wander2);
    float fork = exp(-d1 * d1 * 5000.0 / thickness) * fork_on * smoothstep(0.05, 0.55, p.y);
    float halo = exp(-d0 * 16.0) * 0.4;
    float k = clamp(core * 1.3 + fork * 0.85 + halo, 0.0, 1.0);
    float flicker = 0.75 + 0.25 * hash11(seed + floor(time * 48.0));
    float a = k * flicker;
    return half4(half3(tint.rgb * a), half(a));
}
