// @effect gate_weave
// @summary Film-gate jitter: the frame sits a few pixels off, twenty-four times a second.
// @param amount float 0 0 1 -- 0 is the original, 1 is a loose gate
// @param seed float 1 0 99 -- which weave
half4 main(float2 xy) {
    float4 src = straight(xy);
    if (amount < 0.001) {
        return premul(src.rgb, src.a);
    }
    float2 j = (hash22(float2(floor(time * 24.0), seed)) - 0.5) * amount * 5.0;
    float4 hit = straight(clamp(xy + j, float2(0.0), resolution));
    return premul(hit.rgb, hit.a);
}
