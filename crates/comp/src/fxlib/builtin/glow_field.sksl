// @effect glow_field
// @kind generator
// @summary Two soft colour glows drifting on a dark ground: the ambient light behind a product shot.
// @bounds none
// @param base color #0b0f17 -- ground colour
// @param a color #5a3fc8 -- first glow
// @param b color #1fa6c8 -- second glow
// @param size float 0.55 0.1 1.5 -- glow radius as a share of the frame height
// @param drift float 0.08 0 1 -- how fast the glows wander, cycles per second
// @param amount float 0.8 0 1 -- strength
half4 main(float2 xy) {
    float2 uv = xy / max(resolution, float2(1.0, 1.0));
    float aspect = resolution.x / max(resolution.y, 1.0);
    float t = time * drift * 6.2831853;
    float2 pa = float2(0.3 + 0.12 * sin(t), 0.35 + 0.1 * cos(t * 0.8));
    float2 pb = float2(0.72 + 0.1 * cos(t * 0.9), 0.65 + 0.12 * sin(t * 1.1));
    float da = length((uv - pa) * float2(aspect, 1.0)) / size;
    float db = length((uv - pb) * float2(aspect, 1.0)) / size;
    float ka = exp(-da * da * 2.2);
    float kb = exp(-db * db * 2.2);
    float3 rgb = base.rgb + (a.rgb * ka + b.rgb * kb) * amount;
    rgb += (hash21(xy) - 0.5) * (1.5 / 255.0);
    return premul(clamp(rgb, 0.0, 1.0), 1.0);
}
