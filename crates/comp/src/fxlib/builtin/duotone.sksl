// @effect duotone
// @summary Maps brightness onto two colours: darks become `shadow`, lights become `light`.
// @param shadow color #101030 -- colour of the darkest tones
// @param light color #ffd6a0 -- colour of the lightest tones
// @param amount float 1 0 1 -- 0 keeps the original, 1 is fully mapped
half4 main(float2 xy) {
    float4 c = straight(xy);
    float l = luma(c.rgb);
    float3 mapped = mix(shadow.rgb, light.rgb, l);
    return premul(mix(c.rgb, mapped, amount), c.a);
}
