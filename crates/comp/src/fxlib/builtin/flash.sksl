// @effect flash
// @summary Photographic strobe: a brief white exposure from the centre. Animate `amount` 1→0 for a camera flash.
// @bounds none
// @param amount float 0 0 1 -- 0 is the original, 1 is a full strobe
// @param warmth float 0.12 0 1 -- 0 is paper-white, 1 is tungsten
half4 main(float2 xy) {
    float4 src = straight(xy);
    if (amount < 0.001) {
        return premul(src.rgb, src.a);
    }
    float2 u = xy / max(resolution, float2(1.0, 1.0)) - 0.5;
    float fall = exp(-dot(u, u) * 3.2);
    float3 bulb = mix(float3(1.0, 0.99, 0.97), float3(1.0, 0.86, 0.62), warmth);
    float3 rgb = src.rgb;
    rgb = mix(rgb, float3(luma(rgb)), amount * 0.35);
    rgb = rgb * (1.0 + amount * 1.8 * fall) + bulb * amount * 0.65 * fall;
    return premul(clamp(rgb, 0.0, 2.0), src.a);
}
