// @effect bloom
// @summary Bright areas bleed soft light into their surroundings, like a lens does. Keeps midtones untouched.
// @bounds expand=radius
// @param amount float 0.6 0 2 -- strength of the bleed
// @param radius float 28 2 120 -- how far the light spreads in px
// @param threshold float 0.65 0 1 -- brightness above which light spreads
half4 main(float2 xy) {
    float4 src = straight(xy);
    float3 acc = float3(0.0);
    float w = 0.0;
    for (int ring = 1; ring <= 3; ring++) {
        float r = radius * float(ring) / 3.0;
        for (int i = 0; i < 12; i++) {
            float a = 6.2831853 * (float(i) + 0.5 * float(ring)) / 12.0;
            float4 s = straight(xy + float2(cos(a), sin(a)) * r);
            float bright = smoothstep(threshold, 1.0, luma(s.rgb)) * s.a;
            float k = 1.0 / float(ring);
            acc += s.rgb * bright * k;
            w += k;
        }
    }
    float3 glow = acc / max(w, 1.0) * amount * 2.2;
    float3 rgb = 1.0 - (1.0 - src.rgb) * (1.0 - clamp(glow, 0.0, 1.0));
    float a = clamp(src.a + luma(glow) * 0.5, 0.0, 1.0);
    return premul(rgb, a);
}
