// @effect liquid
// @summary Warps the picture like heat over water or a slow melt; good for dream and memory cuts.
// @param amount float 12 0 60 -- displacement in px
// @param scale float 0.006 0.001 0.03 -- size of the swirls (smaller is bigger swirls)
// @param speed float 0.4 0 3 -- how fast it moves
half4 main(float2 xy) {
    float2 p = xy * scale;
    float t = time * speed;
    float2 d = float2(fbm(p + float2(t, 0.0)) - 0.5, fbm(p + float2(5.2, t)) - 0.5) * 2.0;
    float4 s = straight(xy + d * amount);
    return premul(s.rgb, s.a);
}
