{
  "width": 480,
  "height": 160,
  "fps": 30,
  "dur": 12,
  "job": "stage",
  "best_for": [
    "the room",
    "a caption in space"
  ],
  "breaks": "Camera lives inside a 3D block.",
  "props": [
    "color",
    "x0",
    "y0",
    "x1",
    "y1",
    "cx",
    "cy"
  ],
  "vars": {
    "accent": "#e8402f",
    "ink": "#f6f4ee",
    "mute": "#687e96",
    "plate": "#121a26",
    "loss": "#e8402f",
    "gold": "#deb052",
    "gain": "#3eb696",
    "sub": "#687e96",
    "color": "#ffd37a",
    "x0": 24,
    "y0": 80,
    "x1": 456,
    "y1": 80,
    "cx": 240,
    "cy": 18
  },
  "layers": [
    {
      "type": "shape",
      "id": "arc",
      "layout": "group:connector",
      "items": [
        {
          "d": "M ${x0} ${y0} Q ${cx} ${cy} ${x1} ${y1}",
          "stroke": {
            "color": "$color",
            "width": 3,
            "cap": "round",
            "dash": [
              11,
              9
            ],
            "dash_offset": {
              "from": 0,
              "to": -80,
              "dur": 2.2,
              "ease": "none"
            }
          },
          "trim": {
            "end": {
              "from": 0,
              "to": 1,
              "at": 0.05,
              "dur": 0.7,
              "ease": "power3.inOut"
            }
          }
        }
      ]
    },
    {
      "type": "shape",
      "id": "head",
      "layout": "group:connector",
      "pos": [
        "$x1",
        "$y1"
      ],
      "items": [
        {
          "d": "M -14 -8 L 0 0 L -14 8 Z",
          "fill": "$color"
        }
      ],
      "enter": {
        "preset": "pop",
        "dur": 0.35,
        "delay": 0.65
      }
    }
  ]
}
