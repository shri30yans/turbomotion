// A tint that grows toward the frame edge: coverage k * clamp(distance from centre - 0.5, 0, 1)^1.5, distance measured in
// normalised frame coordinates (-1..1 on both axes), painted over the scene.
uniform float2 res;
uniform float3 colour;
uniform float strength;

half4 main(float2 p) {
    float2 n = (p - 0.5) / (res - 1.0) * 2.0 - 1.0;
    float r = pow(clamp(length(n) - 0.5, 0.0, 1.0), 1.5);
    float a = r * strength;
    return half4(half3(colour * a), half(a));
}
