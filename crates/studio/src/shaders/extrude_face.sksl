// The lit front face of extruded type: vertical colour falloff plus a bevel from the gradient of the blurred
// silhouette (a 3x3 Sobel against the light direction), as the reference's `extruded_text` does with OpenCV.
uniform shader mask;     // glyph coverage (alpha)
uniform shader soft;     // the same, blurred
uniform float height;
uniform float3 face;
uniform float2 light;

float s(float2 p, float dx, float dy) {
    return soft.eval(p + float2(dx, dy)).a;
}

half4 main(float2 p) {
    float a = mask.eval(p).a;
    if (a <= 0.0) return half4(0.0);
    float falloff = mix(1.0, 0.72, (p.y - 0.5) / max(height - 1.0, 1.0));
    float gx = (s(p, 1, -1) + 2.0 * s(p, 1, 0) + s(p, 1, 1)) - (s(p, -1, -1) + 2.0 * s(p, -1, 0) + s(p, -1, 1));
    float gy = (s(p, -1, 1) + 2.0 * s(p, 0, 1) + s(p, 1, 1)) - (s(p, -1, -1) + 2.0 * s(p, 0, -1) + s(p, 1, -1));
    float shade = clamp(-(gx * light.x + gy * light.y) * 2.2, -0.5, 0.5);
    float3 c = clamp(face * falloff + shade * 0.9, 0.0, 1.0);
    return half4(half3(c * a), half(a));
}
