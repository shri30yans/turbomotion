// A soft elliptical ring (attention pulse, ink-dust burst): coverage a * exp(-((d - r) / width)^2).
uniform float2 centre;
uniform float radius;
uniform float width;
uniform float aspect;    // vertical squash: distance is measured as hypot(dx, dy / aspect)
uniform float strength;
uniform float3 colour;
uniform float additive;  // 1 = adds light (alpha 0), 0 = paints over (alpha = coverage)

half4 main(float2 p) {
    float2 d = p - 0.5 - centre;
    float dist = length(float2(d.x, d.y / aspect));
    float m = strength * exp(-pow((dist - radius) / width, 2.0));
    return half4(half3(colour * m), additive > 0.5 ? 0.0 : half(m));
}
